---
---

<div class="relative">
  <input
    type="search"
    id="project-search"
    placeholder="프로젝트 검색..."
    aria-label="프로젝트 검색"
    class="w-full py-3 pl-8 pr-2 bg-transparent border-0 border-b border-slate-300 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-slate-900 dark:focus:border-slate-50 transition-colors"
  />
  <svg
    class="absolute left-0 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
    />
  </svg>
</div>

<script>
  function initProjectSearch() {
    const search = document.querySelector<HTMLInputElement>('#project-search');
    const projectGrid = document.getElementById('projects-grid');
    const empty = document.getElementById('no-results');
    if (!search || !projectGrid || !empty || search.dataset.bound) return;

    search.dataset.bound = 'true';
    const buttons = document.querySelectorAll<HTMLButtonElement>('#techstack-filters button');
    const cards = projectGrid.querySelectorAll<HTMLElement>('[data-project-card]');
    let selectedTech = '';

    function applyFilters(query: string) {
      const normalizedQuery = query.trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const { title, description, tags, techStack = '' } = card.dataset;
        const matchesSearch = [title, description, tags, techStack].some(
          (value) => value?.toLowerCase().includes(normalizedQuery)
        );
        const matchesTech = !selectedTech || techStack.toLowerCase().split(',').includes(selectedTech);
        const matches = matchesSearch && matchesTech;
        card.classList.toggle('hidden', !matches);
        if (matches) visible += 1;
      }
      empty?.classList.toggle('hidden', visible !== 0);
    }

    search.addEventListener('input', () => applyFilters(search.value));
    for (const button of buttons) {
      button.addEventListener('click', () => {
        for (const item of buttons) {
          item.classList.toggle('active', item === button);
          item.setAttribute('aria-pressed', String(item === button));
        }
        selectedTech = button.dataset.filterValue?.toLowerCase() ?? '';
        applyFilters(search.value);
      });
    }
    applyFilters(search.value);
  }

  document.addEventListener('astro:page-load', initProjectSearch);
</script>
