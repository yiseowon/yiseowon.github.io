---
interface Props {
  label: string;
  title: string;
  id?: string;
  level?: 1 | 2;
}

const { label, title, id, level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<header class="mb-10">
  <p class="font-mono text-xs tracking-widest uppercase text-slate-500 dark:text-slate-400">{label}</p>
  <Heading
    id={id}
    class="mt-3 text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50"
  >
    {title}
  </Heading>
  <slot />
</header>
